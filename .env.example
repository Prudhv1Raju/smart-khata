# One Sarvam key covers Saaras (STT), Sarvam-105B (chat), Bulbul (TTS) and Vision (Doc AI)
SARVAM_API_KEY=sk_your_key_here
SHOP_NAME=Sharma Kirana Store

# Optional overrides
# STT_LANGUAGE=unknown        # or hi-IN to pin Hindi
# TTS_MODEL=bulbul:v3
# TTS_SPEAKER=shubh

# Required when deployed publicly: browser asks for this password (any username)
# APP_PASSWORD=choose-a-password
# Samvaad webhook auth: https://<app>/api/webhooks/samvaad?token=<WEBHOOK_TOKEN> (defaults to APP_PASSWORD)
# WEBHOOK_TOKEN=
# Postgres (Vercel + Neon sets this automatically); SQLite is used when unset
# DATABASE_URL=
